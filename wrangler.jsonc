{
  // Static Vite build served as a Cloudflare Worker with static assets (embedded in Vibecade).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solitaire",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
